# Convex creates these values when you run `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# PostHog browser analytics configuration.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# URL where the Next.js application is served.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Create an app and copy its token from https://uploadthing.com/dashboard.
UPLOADTHING_TOKEN=

# Optional production deployment key.
CONVEX_DEPLOY_KEY=

# Set these in the Convex deployment with `npx convex env set`, not in the
# browser-facing Next.js environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=com.nexfiy.web
APPLE_CLIENT_SECRET=

# Resend workspace invitation email. Set these in the Convex deployment.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Nexfiy <invites@your-verified-domain.com>"

# Dodo Payments test-mode billing. Secrets belong in the Convex deployment via
# `npx convex env set`; the public product ID is also needed by the web client
# so seat quantities can be sent to checkout. Production uses live_mode and
# product pdt_0NkWHmeRZI6qHKsuyAW4f; never reuse test credentials in production.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_NEXFIY_PRO_PRODUCT_ID=pdt_0NkRYbcF8y6iQe3WwVZcE
NEXT_PUBLIC_DODO_NEXFIY_PRO_PRODUCT_ID=pdt_0NkRYbcF8y6iQe3WwVZcE
