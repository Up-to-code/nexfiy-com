# Convex creates these values when you run `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# URL where the Next.js application is served.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Create an app and copy its token from https://uploadthing.com/dashboard.
UPLOADTHING_TOKEN=

# Optional production deployment key.
CONVEX_DEPLOY_KEY=
